SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

VITE_ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
VITE_CONTACT_EMAIL="owner@example.com"
VITE_WHATSAPP_URL="https://wa.me/yourhandle"
VITE_SOCIAL_INSTAGRAM="https://instagram.com/yourhandle"
VITE_SOCIAL_FACEBOOK="https://facebook.com/yourhandle"
VITE_SOCIAL_TIKTOK="https://tiktok.com/@yourhandle"
VITE_SOCIAL_PINTEREST="https://pinterest.com/yourhandle"

RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Breakthrough Collection <orders@yourdomain.com>"

# Shippo (server-only; used to quote live rates at checkout and buy labels from admin)
SHIPPO_API_TOKEN="shippo_test_xxx"
SHIPPO_FROM_NAME="Your Name"
SHIPPO_FROM_COMPANY="Breakthrough Collection LLC"
SHIPPO_FROM_STREET1="123 Main St"
SHIPPO_FROM_STREET2=""
SHIPPO_FROM_CITY="Your City"
SHIPPO_FROM_STATE="ST"
SHIPPO_FROM_ZIP="00000"
SHIPPO_FROM_COUNTRY="US"
SHIPPO_FROM_PHONE="+15555555555"
SHIPPO_FROM_EMAIL="owner@example.com"
# Optional default parcel size/weight for rate quotes (inches / lb) — falls
# back to a 10x8x4in, 2lb box if unset.
SHIPPO_PARCEL_LENGTH="10"
SHIPPO_PARCEL_WIDTH="8"
SHIPPO_PARCEL_HEIGHT="4"
SHIPPO_PARCEL_WEIGHT="2"

# Stripe Checkout (hosted). STRIPE_SECRET_KEY is server-only and must NEVER
# get a VITE_ prefix — Vite inlines VITE_ vars into the client bundle. Unlike
# Square, there's no separate "environment" setting to get wrong — Stripe
# determines live vs. test mode from which secret key you use
# (sk_test_... vs sk_live_...).
STRIPE_SECRET_KEY="sk_test_xxx"

# Stripe webhook — reliable payment confirmation independent of whether the
# customer's browser makes it back to /checkout/success. Create the endpoint
# in the Stripe Dashboard (Developers → Webhooks) pointed at
# https://yourdomain.com/webhooks/stripe, subscribed to
# "checkout.session.completed", and it will give you this signing secret.
# Won't fire on plain localhost — needs a public HTTPS URL (a deployed
# preview, or `stripe listen --forward-to` for local testing).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# PayPal Checkout — a second payment option alongside Stripe. Stripe's own
# PayPal integration only covers EEA/UK/Switzerland-based accounts, not this
# US-based one, so this is a fully separate gateway integration.
# PAYPAL_ENVIRONMENT genuinely matters here, unlike Stripe — PayPal has
# wholly separate sandbox vs. live credentials and API hosts, so
# sandbox/live has to be set explicitly rather than inferred from the key
# (set to "live" for real transactions; anything else runs against sandbox).
PAYPAL_CLIENT_ID="sb-xxx"
PAYPAL_CLIENT_SECRET="xxx"
PAYPAL_ENVIRONMENT="sandbox"
# Create the webhook in the PayPal Developer Dashboard (Apps & Credentials →
# your app → Webhooks), pointed at https://yourdomain.com/webhooks/paypal,
# subscribed to "Checkout order approved" and "Payment capture completed".
# That gives you this webhook id, used to verify incoming events are really
# from PayPal.
PAYPAL_WEBHOOK_ID="xxx"

# Order reminder SMS — triggered daily by Vercel Cron (see "crons" in
# vercel.json), which auto-sends "Authorization: Bearer $CRON_SECRET" when
# it calls the cron path, so nothing sensitive needs to be in vercel.json.
# For manual testing, GET /cron/order-reminder?secret=xxx (or header
# x-cron-secret) works too. Texts you via Twilio when orders are stuck at
# status "paid"; no-op (200, sent:false) when nothing's paid-and-pending.
CRON_SECRET="a-long-random-string"
ADMIN_ORDERS_URL="https://yourdomain.com/admin/orders"
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="xxx"
TWILIO_FROM_NUMBER="+15555555555"
TWILIO_TO_NUMBER="+15555555555"
