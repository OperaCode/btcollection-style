SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

VITE_ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
VITE_CONTACT_EMAIL="owner@example.com"
VITE_WHATSAPP_URL="https://wa.me/yourhandle"
VITE_SOCIAL_INSTAGRAM="https://instagram.com/yourhandle"
VITE_SOCIAL_FACEBOOK="https://facebook.com/yourhandle"
VITE_SOCIAL_TIKTOK="https://tiktok.com/@yourhandle"
VITE_SOCIAL_PINTEREST="https://pinterest.com/yourhandle"

RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Breakthrough Collection <orders@yourdomain.com>"

# Shippo (server-only; used to quote live rates at checkout and buy labels from admin)
SHIPPO_API_TOKEN="shippo_test_xxx"
SHIPPO_FROM_NAME="Your Name"
SHIPPO_FROM_COMPANY="Breakthrough Collection LLC"
SHIPPO_FROM_STREET1="123 Main St"
SHIPPO_FROM_STREET2=""
SHIPPO_FROM_CITY="Your City"
SHIPPO_FROM_STATE="ST"
SHIPPO_FROM_ZIP="00000"
SHIPPO_FROM_COUNTRY="US"
SHIPPO_FROM_PHONE="+15555555555"
SHIPPO_FROM_EMAIL="owner@example.com"
# Optional default parcel size/weight for rate quotes (inches / lb) — falls
# back to a 10x8x4in, 2lb box if unset.
SHIPPO_PARCEL_LENGTH="10"
SHIPPO_PARCEL_WIDTH="8"
SHIPPO_PARCEL_HEIGHT="4"
SHIPPO_PARCEL_WEIGHT="2"

# Square hosted Checkout (Payment Links). SQUARE_ACCESS_TOKEN is server-only
# and must NEVER get a VITE_ prefix — Vite inlines VITE_ vars into the client
# bundle. VITE_SQUARE_APPLICATION_ID isn't currently used (only needed if we
# ever add Square's embedded Web Payments SDK back) but is harmless to keep set.
SQUARE_ACCESS_TOKEN="EAAAxxx"
VITE_SQUARE_APPLICATION_ID="sandbox-sq0idb-xxx"
VITE_SQUARE_LOCATION_ID="Lxxxxxxxxxx"
VITE_SQUARE_ENVIRONMENT="sandbox"

# Square webhook — reliable payment confirmation independent of whether the
# customer's browser makes it back to /checkout/success. Create the endpoint
# subscription in the Square Developer Dashboard (Webhooks tab) pointed at
# SQUARE_WEBHOOK_URL, subscribed to "payment.updated", and it will give you
# the signature key. Won't fire on plain localhost — needs a public HTTPS
# URL (a deployed preview, or a tunnel like ngrok, for local testing).
SQUARE_WEBHOOK_URL="https://yourdomain.com/webhooks/square"
SQUARE_WEBHOOK_SIGNATURE_KEY="xxx"
